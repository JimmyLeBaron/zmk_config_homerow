  #include <behaviors.dtsi>
  #include <dt-bindings/zmk/keys.h>
  #include <dt-bindings/zmk/bt.h>
  #include <dt-bindings/zmk/ext_power.h>

  / {
    keymap {
      compatible = "zmk,keymap";
  layer0 {
          bindings = <
          &kp TAB &kp Q &kp W &kp F &kp P &kp B &kp J &kp L &kp U &kp Y &kp SEMICOLON &kp BACKSPACE &kp LEFT_SHIFT &kp A &kp R &kp S &kp T &kp G &kp M &kp N &kp E &kp I &kp O &kp SINGLE_QUOTE LM(1 &kp Z &kp X &kp C &kp D &kp V &kp K &kp H &kp COMMA &kp DOT &kp SLASH &kp ENTER LM(1 &lt 2 SPACE &mo 3 &tog 3 &kp SPACE &kp RIGHT_ALT
          >;
        };layer1 {
          bindings = <
          &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp BACKSPACE &kp LEFT_SHIFT &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMICOLON &kp SINGLE_QUOTE &kp LEFT_CONTROL &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp SLASH &kp ENTER &trans &trans &trans &trans &trans &trans
          >;
        };layer2 {
          bindings = <
          &kp GRAVE [[KC_EXLM]] [[KC_AT]] [[KC_HASH]] [[KC_DLR]] [[KC_PERC]] [[KC_CIRC]] [[KC_AMPR]] [[KC_ASTR]] &kp MINUS &kp EQUAL &kp BACKSPACE &trans &none &none [[KC_LCBR]] [[KC_RCBR]] &none &none [[KC_LPRN]] [[KC_RPRN]] &kp BACKSLASH &kp UP &kp SINGLE_QUOTE &trans &none &kp X &kp C &kp V &none &none &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT &kp DOWN &kp RIGHT &mo 4 &trans &trans &trans [[KC_UNDS]] &trans
          >;
        };layer3 {
          bindings = <
          &kp ESCAPE &none &none &kp UP &none &none &none &kp N7 &kp N8 &kp N9 &none &kp BACKSPACE &trans [[DF(1)]] &kp LEFT &kp DOWN &kp RIGHT &none &none &kp N4 &kp N5 &kp N6 &kp DOT &none &trans [[DF(0)]] &kp LEFT_CONTROL &kp LEFT_ALT &kp DELETE &none &kp COMMA &kp N1 &kp N2 &kp N3 [[KC_COLN]] &kp ENTER &trans &trans &trans &trans &kp SPACE &kp N0
          >;
        };layer4 {
          bindings = <
          &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans &none &none &none &none &none &none &kp K_APPLICATION &none &none &kp PAGE_UP &none &trans &none &none &none &none &none &none &none &none &kp HOME &kp PAGE_DOWN &kp END &trans &none &none &none &none &none
          >;
        };
    };
  };
  
