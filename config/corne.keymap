#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    // --- Macros for switching device + layer simultaneously ---
    macros {
        switch_mac {
            compatible = "zmk,behavior-macro";
            bindings = <
                &bt BT_SEL 1     // Switch to Bluetooth device 2 (Mac)
                &tog 6           // Switch to Mac layer (layer_6)
            >;
        };
        switch_win {
            compatible = "zmk,behavior-macro";
            bindings = <
                &bt BT_SEL 0     // Switch to Bluetooth device 1 (Windows)
                &tog 0           // Switch to Windows layer (layer_0)
            >;
        };
    };

    lm: lm {
        compatible = "zmk,behavior-macro-two-param";
        wait-ms = <0>;
        tap-ms = <0>;
        #binding-cells = <2>;
        bindings =
            <&macro_param_1to1>,
            <&macro_press>,
            <&mo MACRO_PLACEHOLDER &macro_param_2to1>,
            <&macro_press>,
            <&kp MACRO_PLACEHOLDER>,
            <&macro_pause_for_release>,
            <&macro_param_2to1>,
            <&macro_release>,
            <&kp MACRO_PLACEHOLDER &macro_param_1to1>,
            <&macro_release>,
            <&mo MACRO_PLACEHOLDER>;
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp TAB      &kp Q  &kp W  &kp F       &kp P  &kp B    &kp J   &kp L      &kp U      &kp Y    &kp SEMI  &kp BSPC
&kp LSHFT    &kp A  &kp R  &kp S       &kp T  &kp G    &kp M   &kp N      &kp E      &kp I    &kp O     &kp SINGLE_QUOTE
&lm 1 LCTRL  &kp Z  &kp X  &kp C       &kp D  &kp V    &kp K   &kp H      &kp COMMA  &kp DOT  &kp FSLH  &kp RET
                           &lm 1 LGUI  &mo 2  &mo 3    &tog 3  &kp SPACE  &kp RALT
            >;
        };

        layer_1 {
            bindings = <
&trans  &kp Q  &kp W  &kp E   &kp R   &kp T     &kp Y   &kp U   &kp I      &kp O    &kp P     &trans
&trans  &kp A  &kp S  &kp D   &kp F   &kp G     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &trans
&trans  &kp Z  &kp X  &kp C   &kp V   &kp B     &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
                      &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&kp GRAVE  &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)    &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp MINUS  &kp EQUAL  &kp BSPC
&trans     &trans        &trans      &kp LS(LBRC)   &kp LS(RBRC)  &trans           &trans         &kp LS(LPAR)  &kp LS(RPAR)  &kp BSLH   &kp UP     &kp SQT
&trans     &trans        &kp X       &kp C          &kp V         &trans           &trans         &kp LBKT      &kp RBKT      &kp LEFT   &kp DOWN   &kp RIGHT
                                     &mo 4          &trans        &trans           &trans         &kp UNDER     &trans
            >;
        };

        layer_3 {
            bindings = <
&kp ESC  &trans  &trans     &kp UP    &trans      &trans    &trans     &kp N7     &kp N8  &kp N9  &trans    &kp BSPC
&trans   &trans  &kp LEFT   &kp DOWN  &kp RIGHT   &trans    &trans     &kp N4     &kp N5  &kp N6  &kp DOT   &trans
&trans   &trans  &kp LCTRL  &kp LALT  &kp DELETE  &trans    &kp COMMA  &kp N1     &kp N2  &kp N3  &kp SEMI  &kp RET
                            &trans    &trans      &trans    &trans     &kp SPACE  &kp N0
            >;
        };

        layer_4 {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6    &kp F7        &kp F8             &kp F9        &kp F10   &kp F11        &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans        &kp K_APPLICATION  &trans        &trans    &kp PAGE_UP    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &switch_win   &switch_mac         &bt BT_SEL 2  &kp HOME  &kp PAGE_DOWN  &kp END
                        &trans  &trans  &tog 1    &soft_off     &mo 5              &bt BT_CLR
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &bt BT_CLR_ALL
            >;
        };

        layer_6 { // Mac Layer
            bindings = <
&kp TAB      &kp Q  &kp W  &kp F       &kp P  &kp B    &kp J   &kp L      &kp U      &kp Y    &kp SEMI  &kp BSPC
&kp LSHFT    &kp A  &kp R  &kp S       &kp T  &kp G    &kp M   &kp N      &kp E      &kp I    &kp O     &kp SINGLE_QUOTE
&lm 1 LGUI   &kp Z  &kp X  &kp C       &kp D  &kp V    &kp K   &kp H      &kp COMMA  &kp DOT  &kp FSLH  &kp RET
                           &lm 1 LCTRL &mo 2  &mo 3    &tog 3  &kp SPACE  &kp RALT
            >;
        };
    };
};
