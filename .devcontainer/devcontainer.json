{
  "image": "zmkfirmware/zmk-dev-arm:3.5",
  "remoteEnv": {
    "ZMK_CONFIG": "${containerWorkspaceFolder}/config"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "xaver.clang-format"
      ]
    }
  },
  "postCreateCommand": "[ ! -d .west ] && west init -l config || true; west update",
  "postStartCommand": "chmod +x ${containerWorkspaceFolder}/build.sh && (grep -q 'alias build' ~/.bashrc || echo 'alias build=\"${containerWorkspaceFolder}/build.sh\"' >> ~/.bashrc)"
}
