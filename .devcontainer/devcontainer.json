{
  "image": "zmkfirmware/zmk-dev-arm:3.5",
  "remoteEnv": {
    "ZMK_CONFIG": "${containerWorkspaceFolder}/config"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "xaver.clang-format"
      ]
    }
  },
  "postCreateCommand": "[ ! -d .west ] && west init -l config || true; west update",
  "postStartCommand": "chmod +x /workspaces/zmk-config-homerow/build.sh && grep -q 'alias build' ~/.bashrc || echo 'alias build=\"/workspaces/zmk-config-homerow/build.sh\"' >> ~/.bashrc"
}
